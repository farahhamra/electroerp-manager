<Window x:Class="ElectroERP.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ElectroERP Manager"
        Icon="pack://application:,,,/ElectroERP.Manager;component/assets/electroerp-manager-icon.ico"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BgCanvasBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BgCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clean Light Title Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderMutedBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <Image Source="pack://application:,,,/ElectroERP.Manager;component/assets/electroerp-manager-icon.ico"
                           Width="20" Height="20"
                           Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="ElectroERP"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" Manager"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="46" Height="45"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Cursor="Hand"
                            Click="OnMinimizeClick">
                        <TextBlock Text="—" FontSize="11" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Width="46" Height="45"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Cursor="Hand"
                            Click="OnMaximizeRestoreClick">
                        <TextBlock x:Name="MaximizeIcon" Text="❐" FontSize="12" />
                    </Button>
                    <Button Width="46" Height="45"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Cursor="Hand"
                            Click="OnCloseClick">
                        <TextBlock Text="✕" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Tabs Bar -->
        <Border Grid.Row="1"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderMutedBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <RadioButton x:Name="TabStart"
                             Content="Start"
                             Style="{StaticResource NavTabStyle}"
                             Checked="OnTabChecked" />
                <RadioButton x:Name="TabUpdater"
                             Content="Updater"
                             Style="{StaticResource NavTabStyle}"
                             Checked="OnTabChecked" />
                <RadioButton x:Name="TabSettings"
                             Content="Settings"
                             Style="{StaticResource NavTabStyle}"
                             Checked="OnTabChecked" />
            </StackPanel>
        </Border>

        <!-- Active Page Content Host -->
        <ContentControl x:Name="PageContentHost"
                        Grid.Row="2"
                        Background="{StaticResource BgCanvasBrush}" />
    </Grid>
</Window>
