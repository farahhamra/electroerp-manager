<UserControl x:Class="ElectroERP.Manager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgCanvasBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,24">

            <!-- ROW 1: System Behavior (Checkboxes: Windows Startup & Auto Crash Recovery) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Windows Startup -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Start with Windows"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Launch manager minimized to tray on boot"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="StartupSwitch"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="OnStartupToggled"
                                  Unchecked="OnStartupToggled" />
                    </Grid>
                </Border>

                <!-- Right: Auto Crash Recovery -->
                <Border Grid.Column="2"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Automatic Crash Recovery"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Up to 5 tries (1st, 5s, 5s, 5s, 7s) if unexpected crash"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="AutoRestartSwitch"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="OnAutoRestartToggled"
                                  Unchecked="OnAutoRestartToggled" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Backend Location (Full Width - Remained As It Was) -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Backend Location"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Node.js API folder containing dist/index.js"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ServerPathBox"
                                 Grid.Column="0"
                                 Style="{StaticResource MinimalTextBoxStyle}"
                                 Margin="0,0,8,0"
                                 LostFocus="OnServerPathLostFocus" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnBrowseClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Frontend Location (Full Width - Remained As It Was) -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Frontend Location"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Next.js app folder containing .next build"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FrontendPathBox"
                                 Grid.Column="0"
                                 Style="{StaticResource MinimalTextBoxStyle}"
                                 Margin="0,0,8,0"
                                 LostFocus="OnFrontendPathLostFocus" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnBrowseFrontendClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Website Location (Full Width) -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Website Location"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Premium Website Engine folder (electroerp-website)"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WebsitePathBox"
                                 Grid.Column="0"
                                 Style="{StaticResource MinimalTextBoxStyle}"
                                 Margin="0,0,8,0"
                                 LostFocus="OnWebsitePathLostFocus" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnBrowseWebsiteClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ROW 3: Security & Maintenance (PIN & Database Backup) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Security PIN -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Security PIN"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="6-digit authentication required for actions"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Change PIN"
                                Style="{StaticResource GhostButtonStyle}"
                                VerticalAlignment="Center"
                                Click="OnChangePinClick" />
                    </Grid>
                </Border>

                <!-- Right: Database Backup -->
                <Border Grid.Column="2"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Database Backup"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="BackupStatusLabel"
                                       Text="Checking backup status..."
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="Location: ../private/backup/"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="BackupButton"
                                Grid.Column="1"
                                Content="Backup Now"
                                Style="{StaticResource GhostButtonStyle}"
                                VerticalAlignment="Center"
                                Click="OnBackupClick" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Save Status Indicator -->
            <TextBlock x:Name="SaveNoticeLabel"
                       Text="Settings saved."
                       FontSize="11"
                       Foreground="{StaticResource StatusRunningBrush}"
                       HorizontalAlignment="Right"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
