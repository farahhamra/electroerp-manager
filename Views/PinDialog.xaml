<Window x:Class="ElectroERP.Manager.Views.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIN Authentication"
        Icon="pack://application:,,,/ElectroERP.Manager;component/assets/electroerp-manager-icon.ico"
        Height="360" Width="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Base Caret Style -->
            <Style x:Key="CaretStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="2" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Shake Storyboard -->
            <Storyboard x:Key="ShakeAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DialogContainer"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.04" Value="-12" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="12" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="-8" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="8" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="-4" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="4" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="DialogContainer"
            Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource BorderMutedBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28,24"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="0" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.12" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Clean Stacked Header (Zero Overlap Guaranteed) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/ElectroERP.Manager;component/assets/electroerp-manager-icon.ico"
                       Width="32" Height="32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="TitleLabel"
                           Text="Enter 6-Digit PIN"
                           FontSize="17"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />

                <TextBlock x:Name="PromptLabel"
                           Text="Enter your 6-digit PIN to access ElectroERP Manager"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="310" />
            </StackPanel>

            <!-- ElectroERP Style PIN Box with Floating Label & 6 Slots -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,6">
                <!-- Outer Border Box -->
                <Border x:Name="PinBoxBorder"
                        Width="320" Height="56"
                        Background="#ffffff"
                        BorderBrush="{StaticResource BorderFocusBrush}"
                        BorderThickness="2"
                        CornerRadius="12">
                    <!-- 6 Slots Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Slot 0 -->
                        <Grid Grid.Column="0">
                            <TextBlock x:Name="Digit0" FontSize="22" FontWeight="Bold" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Rectangle x:Name="Caret0" Style="{StaticResource CaretStyle}" Visibility="Collapsed" />
                            <Border Width="1" Height="26" Background="{StaticResource BorderMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Slot 1 -->
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="Digit1" FontSize="22" FontWeight="Bold" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Rectangle x:Name="Caret1" Style="{StaticResource CaretStyle}" Visibility="Collapsed" />
                            <Border Width="1" Height="26" Background="{StaticResource BorderMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Slot 2 -->
                        <Grid Grid.Column="2">
                            <TextBlock x:Name="Digit2" FontSize="22" FontWeight="Bold" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Rectangle x:Name="Caret2" Style="{StaticResource CaretStyle}" Visibility="Collapsed" />
                            <Border Width="1" Height="26" Background="{StaticResource BorderMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Slot 3 -->
                        <Grid Grid.Column="3">
                            <TextBlock x:Name="Digit3" FontSize="22" FontWeight="Bold" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Rectangle x:Name="Caret3" Style="{StaticResource CaretStyle}" Visibility="Collapsed" />
                            <Border Width="1" Height="26" Background="{StaticResource BorderMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Slot 4 -->
                        <Grid Grid.Column="4">
                            <TextBlock x:Name="Digit4" FontSize="22" FontWeight="Bold" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Rectangle x:Name="Caret4" Style="{StaticResource CaretStyle}" Visibility="Collapsed" />
                            <Border Width="1" Height="26" Background="{StaticResource BorderMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Slot 5 -->
                        <Grid Grid.Column="5">
                            <TextBlock x:Name="Digit5" FontSize="22" FontWeight="Bold" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Rectangle x:Name="Caret5" Style="{StaticResource CaretStyle}" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Floating Label resting on top border -->
                <Border Background="#ffffff"
                        Padding="6,0"
                        Margin="14,-9,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="FloatingLabel"
                               Text="Security PIN"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                </Border>
            </Grid>

            <!-- Dynamic Feedback / Error Message -->
            <TextBlock x:Name="ErrorLabel"
                       Grid.Row="2"
                       Text="Incorrect PIN. Please try again."
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{StaticResource ActionStopBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,12"
                       Visibility="Hidden" />

            <!-- Action Buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource GhostButtonStyle}"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="OnCancelClick" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Width="100"
                        Click="OnConfirmClick">
                    <TextBlock Text="Confirm" Foreground="#ffffff" FontWeight="SemiBold" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
