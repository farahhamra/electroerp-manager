<Window x:Class="ElectroERP.Manager.Views.ChangePinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change PIN"
        Icon="pack://application:,,,/ElectroERP.Manager;component/assets/electroerp-manager-icon.ico"
        Height="380" Width="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource BorderMutedBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.08" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Text="Change Authentication PIN"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,20" />

            <!-- Current PIN -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Current 6-Digit PIN"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <PasswordBox x:Name="CurrentPinBox"
                             MaxLength="6"
                             Background="#ffffff"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderMutedBrush}"
                             BorderThickness="1"
                             Padding="12,8"
                             FontSize="14" />
            </StackPanel>

            <!-- New PIN -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="New 6-Digit PIN"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <PasswordBox x:Name="NewPinBox"
                             MaxLength="6"
                             Background="#ffffff"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderMutedBrush}"
                             BorderThickness="1"
                             Padding="12,8"
                             FontSize="14" />
            </StackPanel>

            <!-- Confirm New PIN -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="Confirm New PIN"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <PasswordBox x:Name="ConfirmPinBox"
                             MaxLength="6"
                             Background="#ffffff"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderMutedBrush}"
                             BorderThickness="1"
                             Padding="12,8"
                             FontSize="14" />
            </StackPanel>

            <!-- Error Feedback -->
            <TextBlock x:Name="ErrorLabel"
                       Grid.Row="4"
                       FontSize="11"
                       Foreground="{StaticResource ActionStopBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       Visibility="Collapsed" />

            <!-- Actions -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource GhostButtonStyle}"
                        Width="85"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Width="95"
                        Click="OnSaveClick">
                    <TextBlock Text="Save PIN" Foreground="#ffffff" FontWeight="SemiBold" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
