<UserControl x:Class="ElectroERP.Manager.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElectroERP.Manager.Views"
             Background="{StaticResource BgCanvasBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,20" MaxWidth="980">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Summary Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,14"
                    Margin="6,0,6,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="SummaryStatusDot"
                                 Width="10" Height="10"
                                 Fill="{StaticResource StatusStoppedBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0" />
                        <TextBlock x:Name="SummaryStatusText"
                                   Text="ElectroERP stopped · Offline · v1.4.2"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="RestartAllButton"
                            Grid.Column="1"
                            Content="Restart all"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="14,7"
                            IsEnabled="False"
                            Click="OnRestartAllClick" />
                </Grid>
            </Border>

            <!-- Per-Service Cards Grid -->
            <UniformGrid Grid.Row="1"
                         Columns="3"
                         Margin="0,0,0,10">
                <local:ServiceCard x:Name="ErpServerCard"
                                   CardTitle="ERP Server"
                                   Address="localhost:3000"
                                   ShowSecondaryButton="True"
                                   SecondaryButtonText="Restart"
                                   LinkText="Open app ↗"
                                   PrimaryActionClick="OnServerActionClick"
                                   SecondaryActionClick="OnRestartServerClick"
                                   LinkActionClick="OnOpenBrowserClick" />

                <local:ServiceCard x:Name="OnlineAccessCard"
                                   CardTitle="Online Access"
                                   Address="electroerp-prod"
                                   ShowSecondaryButton="False"
                                   LinkText="Copy URL ⧉"
                                   PrimaryActionClick="OnOnlineTunnelClick"
                                   LinkActionClick="OnCopyOnlineUrlClick" />

                <local:ServiceCard x:Name="WebsiteCard"
                                   CardTitle="Website"
                                   Address="/store"
                                   ShowSecondaryButton="False"
                                   LinkText="Open website ↗"
                                   PrimaryActionClick="OnWebsiteActionClick"
                                   LinkActionClick="OnOpenWebsiteClick" />
            </UniformGrid>

            <!-- Collapsible Error Diagnostics Section -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="6,0,6,14">
                <StackPanel>
                    <Grid Margin="18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="DiagnosticsToggleButton"
                                Grid.Column="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnToggleDiagnosticsClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="DiagnosticsChevron"
                                           Text="▸"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Width="16"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="ErrorCountLabel"
                                           Text="Error diagnostics (0 today)"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CopyErrorsButton"
                                Grid.Column="1"
                                Content="Copy"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="12,4"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Click="OnCopyErrorsClick" />
                    </Grid>

                    <Border x:Name="DiagnosticsLogBorder"
                            BorderBrush="{StaticResource BorderMutedBrush}"
                            BorderThickness="0,1,0,0"
                            Background="{StaticResource BgCanvasBrush}"
                            Height="200"
                            Padding="16,12"
                            Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="LogOutput"
                                       Text="No runtime errors recorded."
                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <TextBlock x:Name="PinNoticeText"
                       Grid.Row="3"
                       Text="🔒 Actions require PIN confirmation"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0" />
        </Grid>
    </ScrollViewer>
</UserControl>
