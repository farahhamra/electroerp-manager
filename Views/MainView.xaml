<UserControl x:Class="ElectroERP.Manager.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgCanvasBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ElectroERP.Manager;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="32,20,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Centered Core Action Zone -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- Single Authoritative Status Display -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8">
                <Ellipse x:Name="StatusDot"
                         Width="10" Height="10"
                         Fill="{StaticResource StatusStoppedBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0" />
                <TextBlock x:Name="StatusLabel"
                           Text="Status: Stopped"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Cloudflare Tunnel Status Display -->
            <!-- Cloudflare Tunnel Status Display -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,6">
                <Ellipse x:Name="TunnelStatusDot"
                         Width="8" Height="8"
                         Fill="{StaticResource StatusStoppedBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
                <TextBlock x:Name="TunnelStatusLabel"
                           Text="Tunnel (electroerp-prod): Offline"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- Website Engine Status Display -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,22">
                <Ellipse x:Name="WebsiteStatusDot"
                         Width="8" Height="8"
                         Fill="{StaticResource StatusStoppedBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
                <TextBlock x:Name="WebsiteStatusLabel"
                           Text="Website (localhost:3001): Stopped"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- Primary Server Action Buttons (Launch / Stop + Restart alongside when Running) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="ServerActionButton"
                        Content="Launch ElectroERP"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="180"
                        Height="44"
                        Click="OnServerActionClick" />

                <Button x:Name="RestartServerButton"
                        Content="Restart Server"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="160"
                        Height="44"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Click="OnRestartServerClick" />
            </StackPanel>

            <!-- Secondary Actions: Go Online (Cloudflare Tunnel) & Open Web App -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0">
                <Button x:Name="OnlineTunnelButton"
                        Content="Go Online"
                        Style="{StaticResource GhostButtonStyle}"
                        MinWidth="160"
                        Height="38"
                        Click="OnOnlineTunnelClick" />

                <Button x:Name="OpenBrowserButton"
                        Style="{StaticResource GhostButtonStyle}"
                        MinWidth="170"
                        Height="38"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Click="OnOpenBrowserClick">
                    <TextBlock FontSize="12">
                        <Run Text="Open " Foreground="{StaticResource TextPrimaryBrush}" />
                        <Run Text="ElectroERP" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        <Run Text=" App" Foreground="{StaticResource TextPrimaryBrush}" />
                    </TextBlock>
                </Button>
            </StackPanel>

            <!-- Website Actions: Launch/Stop Website & Open Website -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <Button x:Name="WebsiteActionButton"
                        Content="Launch Website"
                        Style="{StaticResource GhostButtonStyle}"
                        MinWidth="160"
                        Height="38"
                        Click="OnWebsiteActionClick" />

                <Button x:Name="OpenWebsiteButton"
                        Style="{StaticResource GhostButtonStyle}"
                        MinWidth="170"
                        Height="38"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Click="OnOpenWebsiteClick">
                    <TextBlock FontSize="12">
                        <Run Text="Open " Foreground="{StaticResource TextPrimaryBrush}" />
                        <Run Text="Website" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        <Run Text=" (:3001)" Foreground="{StaticResource TextPrimaryBrush}" />
                    </TextBlock>
                </Button>
            </StackPanel>

            <TextBlock x:Name="PinNoticeText"
                       Text="PIN confirmation required"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>

        <!-- Quiet Bottom Diagnostic Section -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Subtle Section Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Error Diagnostics"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ErrorCountLabel"
                           Text="0 errors today"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Monospace Log Box (Bigger Height + Top-Right Copy Button) -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="200"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,8,0">
                        <TextBlock x:Name="LogOutput"
                                   Text="No runtime errors recorded."
                                   FontFamily="Consolas, Cascadia Code, Courier New"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <Button x:Name="CopyErrorsButton"
                            Grid.Column="1"
                            Content="Copy"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Click="OnCopyErrorsClick" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
