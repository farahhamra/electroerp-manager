<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Neutral Canvas Tokens -->
    <Color x:Key="BgCanvasColor">#f8fafc</Color>
    <Color x:Key="BgSurfaceColor">#ffffff</Color>
    <Color x:Key="BgElevatedColor">#f1f5f9</Color>
    <Color x:Key="BorderMutedColor">#e2e8f0</Color>
    <Color x:Key="BorderFocusColor">#4f46e5</Color>

    <!-- Typography Tokens -->
    <Color x:Key="TextPrimaryColor">#0f172a</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#64748b</Color>

    <!-- Semantic & Accent Tokens -->
    <Color x:Key="AccentColor">#4f46e5</Color>
    <Color x:Key="AccentHoverColor">#4338ca</Color>
    <Color x:Key="StatusRunningColor">#10b981</Color>
    <Color x:Key="StatusStoppedColor">#64748b</Color>
    <Color x:Key="ActionStopColor">#ef4444</Color>
    <Color x:Key="ActionStopHoverColor">#dc2626</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BgCanvasBrush" Color="{StaticResource BgCanvasColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BorderMutedBrush" Color="{StaticResource BorderMutedColor}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="StatusRunningBrush" Color="{StaticResource StatusRunningColor}" />
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="{StaticResource StatusStoppedColor}" />
    <SolidColorBrush x:Key="ActionStopBrush" Color="{StaticResource ActionStopColor}" />
    <SolidColorBrush x:Key="ActionStopHoverBrush" Color="{StaticResource ActionStopHoverColor}" />

</ResourceDictionary>
